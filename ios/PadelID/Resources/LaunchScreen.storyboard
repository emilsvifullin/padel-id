<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="23094" targetRuntime="iOS.CocoaTouch" useAutolayout="YES" launchScreen="YES" initialViewController="launch-controller">
    <device id="retina6_9" orientation="portrait" appearance="dark"/>
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="23084"/>
    </dependencies>
    <scenes>
        <scene sceneID="launch-scene">
            <objects>
                <viewController id="launch-controller" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="launch-root">
                        <rect key="frame" x="0.0" y="0.0" width="440" height="956"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFill" image="TennisLaunch.jpg" translatesAutoresizingMaskIntoConstraints="NO" id="launch-photo">
                                <rect key="frame" x="0.0" y="0.0" width="440" height="956"/>
                            </imageView>
                            <imageView userInteractionEnabled="NO" contentMode="scaleToFill" image="TennisWelcomeShade.png" translatesAutoresizingMaskIntoConstraints="NO" id="launch-shade">
                                <rect key="frame" x="0.0" y="0.0" width="440" height="956"/>
                            </imageView>
                        </subviews>
                        <color key="backgroundColor" white="0.0" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                        <constraints>
                            <constraint firstItem="launch-photo" firstAttribute="top" secondItem="launch-root" secondAttribute="top" id="photo-top"/>
                            <constraint firstItem="launch-photo" firstAttribute="leading" secondItem="launch-root" secondAttribute="leading" id="photo-leading"/>
                            <constraint firstItem="launch-photo" firstAttribute="trailing" secondItem="launch-root" secondAttribute="trailing" id="photo-trailing"/>
                            <constraint firstItem="launch-photo" firstAttribute="bottom" secondItem="launch-root" secondAttribute="bottom" id="photo-bottom"/>
                            <constraint firstItem="launch-shade" firstAttribute="top" secondItem="launch-photo" secondAttribute="top" id="shade-top"/>
                            <constraint firstItem="launch-shade" firstAttribute="leading" secondItem="launch-photo" secondAttribute="leading" id="shade-leading"/>
                            <constraint firstItem="launch-shade" firstAttribute="trailing" secondItem="launch-photo" secondAttribute="trailing" id="shade-trailing"/>
                            <constraint firstItem="launch-shade" firstAttribute="bottom" secondItem="launch-photo" secondAttribute="bottom" id="shade-bottom"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="launch-responder" sceneMemberID="firstResponder"/>
            </objects>
        </scene>
    </scenes>
    <resources>
        <image name="TennisLaunch.jpg" width="735" height="1244"/>
        <image name="TennisWelcomeShade.png" width="4" height="1024"/>
    </resources>
</document>

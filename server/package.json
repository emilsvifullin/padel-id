{
  "name": "padel-id-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Padel ID public API gateway (Vercel)",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:edge": "node scripts/build-edge.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run test/app.test.ts test/edge-handler.test.ts test/edge-relay.test.ts test/clubs.test.ts test/push-routes.test.ts test/push-provider.test.ts test/push-worker.test.ts",
    "start:local": "node dist/dev-server.js",
    "test:e2e": "node scripts/test-e2e.mjs"
  },
  "dependencies": {
    "hono": "4.13.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@hono/node-server": "2.1.1",
    "@types/node": "22.20.4",
    "pg": "8.23.0",
    "@types/pg": "8.23.0",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  },
  "packageManager": "pnpm@10.28.0"
}
